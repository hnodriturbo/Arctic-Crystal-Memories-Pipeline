# ═══════════════════════════════════════════════════════════════
# Arctic Crystal Memories — Crystal Workshop Environment Variables (TEMPLATE)
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values before running the app.
#
#   cp .env.example .env.local
#
# NEVER commit a filled-in env file to git. Every .env* except this one is in
# .gitignore. This .env.example is safe to commit — it contains no secrets.
# Section order here matches .env.local, .env.development and .env.production.

# ─────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────

# Public origin behind the reverse proxy. Auth.js needs it to
# build callback URLs. Local development infers it and omits this.
AUTH_URL=http://localhost:3100

# Accepted only under `next dev`, for local visual QA.
# A production build ignores it entirely.
PIPELINE_DEV_AUTH_BYPASS=false

# ─────────────────────────────────────────────────────────────
# DATABASE — PostgreSQL
# ─────────────────────────────────────────────────────────────

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# The VPS has its own acm_pipeline database with a dedicated
# acm_pipeline_user role; locally this reuses the postgres superuser
# the way every other project on that machine does.
# 
# In .env.production this stays empty on purpose. The real value lives only in
# the VPS's shared/.env.production, and a production database URL sitting on a
# laptop is a mistake waiting to happen - the key is listed so both files carry
# the same set, not so it can be filled in here.
DATABASE_URL=postgresql://postgres:password@localhost:5432/acm_pipeline

# ─────────────────────────────────────────────────────────────
# NEXT-AUTH v5
# ─────────────────────────────────────────────────────────────

# Signs the session cookie. Rotating it invalidates every session at once.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In .env.production this stays empty: the real value lives only in the VPS's
# shared/.env.production. The key is listed so both files carry the same set.
AUTH_SECRET=

# true when behind Nginx or Cloudflare.
AUTH_TRUST_HOST=true

# ─────────────────────────────────────────────────────────────
# AGENT REVIEW ACCOUNT
# ─────────────────────────────────────────────────────────────

# A separate operator account for an AI agent reviewing the workshop, kept
# apart from the owner's sign-in so its activity is distinguishable in the
# auth log and it can be disabled on its own.
# 
# Sign-in is by email: the User model has no username column, so the name is
# what AGENT_USERNAME says and AGENT_EMAIL is the address actually typed.
# Created and rotated with:  npm run db:seed:agent
AGENT_USERNAME="ClaudeCodexCLI"

AGENT_EMAIL=claudecodexcli@acm.is

AGENT_PASSWORD=

# ─────────────────────────────────────────────────────────────
# PIPELINE 1 — CONVERTER
# ─────────────────────────────────────────────────────────────

# Without this it falls back to ../pipeline-converter, which is
# correct for a normal checkout.
CONVERTER_ROOT=D:/path/to/Crystal_Clear_Memories/CCM-Web-Workshop/Crystal-Workshop/pipeline-converter

# Optional. Defaults to CONVERTER_ROOT\.venv\Scripts\python.exe
CONVERTER_PYTHON=

# Shared Blender 4.5 LTS binary. Not copied into each release.
BLENDER_EXE=

# ─────────────────────────────────────────────────────────────
# PIPELINE 2 — MESHY
# ─────────────────────────────────────────────────────────────

MESHY_ROOT=D:/path/to/Crystal_Clear_Memories/CCM-Web-Workshop/Crystal-Workshop/meshy-pipeline

MESHY_PYTHON=

MESHY_API_URL=https://api.meshy.ai/openapi

# Secret. Kept in .env.local so it never lands in a file that could be
# committed by accident; set it here instead on a box with no .env.local.
MESHY_API_KEY=

# How often a running generation is re-checked.
MESHY_POLL_INTERVAL_MS=4000

# From Meshy's portal, Webhooks section. Verifies deliveries to
# https://workshop.acm.is/webhooks/meshy
MESHY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# PIPELINE 3 — IMAGE CLEAN-UP
# ─────────────────────────────────────────────────────────────

# Empty disables the clean-up step; Meshy still enhances server-side.
# CUDA locally, CPU-only rembg on the VPS.
IMAGE_PIPELINE_ROOT=D:/path/to/Crystal_Clear_Memories/CCM-Web-Workshop/Crystal-Workshop/image-pipeline

IMAGE_PIPELINE_PYTHON=

# Shared rembg model cache, preloaded rather than downloaded per job.
U2NET_HOME=

# ─────────────────────────────────────────────────────────────
# CLAUDE DESIGN — ANIMATIONS
# ─────────────────────────────────────────────────────────────

# The design tree the animations page reads, renders from and mirrors to
# acm-workshop. On the operator's machine this is the real repository; on
# the VPS it is a scratch workspace that fills from R2 on demand.
CLAUDE_DESIGN_ROOT=D:/path/to/Crystal_Clear_Memories/Claude-Design-Stuff

# ─────────────────────────────────────────────────────────────
# OPENAI — PROMPT WRITER
# ─────────────────────────────────────────────────────────────

# Empty hides the "describe this photo" button; the rest still works.
OPENAI_API_KEY=

OPENAI_VISION_MODEL=gpt-5.6-luna

# ─────────────────────────────────────────────────────────────
# R2 — acm-pipeline-eu
# ─────────────────────────────────────────────────────────────

# Private bucket, EU jurisdiction. Finished jobs are mirrored to jobs/<id>/
# so they outlive the server; downloads go out as short-lived presigned URLs.
# Token "ACM-Web-Pipeline" — needs Object Read AND Write.
R2_PIPELINE_ACCOUNT_ID=4174c03e715754d2c44a4cdeae409a8d

R2_PIPELINE_ENDPOINT=https://4174c03e715754d2c44a4cdeae409a8d.eu.r2.cloudflarestorage.com

R2_PIPELINE_BUCKET_NAME=acm-pipeline-eu

R2_PIPELINE_ACCESS_KEY_ID=

R2_PIPELINE_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# R2 — acm-workshop
# ─────────────────────────────────────────────────────────────

# Private bucket, EU jurisdiction, created 20-09-2026. Owns every piece of
# R2 storage belonging to this workshop from here on; Claude Design lives
# under claude-design/. The other pipelines move here gradually — see
# docs/R2-WORKSHOP-BUCKET.md. Token "acm-workshop-api", Object Read AND Write.
# Note the .eu. in the endpoint: an EU-jurisdiction bucket has its own host.
R2_WORKSHOP_ACCOUNT_ID=

R2_WORKSHOP_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com

R2_WORKSHOP_BUCKET_NAME=acm-workshop

R2_WORKSHOP_ACCESS_KEY_ID=

R2_WORKSHOP_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# DEVELOPMENT ONLY
# ─────────────────────────────────────────────────────────────

# Keeps finished relief job folders on disk for inspection.
RELIEF_KEEP_JOBS=false
