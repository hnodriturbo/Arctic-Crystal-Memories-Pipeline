# ============================================================
# K9 Crystal Pipeline — Environment Variables
# ============================================================
# --> .env.example. Modify this line to be pipeline title <--
# Note: .env* files are never staged or committed.
# ============================================================

# --- Hardware ---
# Set to cpu if no GPU available (will be very slow)
DEVICE=cuda

# --- Input / Output paths ---
# Where the pipeline reads source images from
INPUT_DIR=./input

# Where all pipeline outputs are saved (depth maps, meshes, exports)
OUTPUT_DIR=./output

# --- Upscaling settings ---
# Upscale factor before depth estimation (2 or 4 recommended)
UPSCALE_FACTOR=4

# --- Depth estimation model ---
# Options: depth_anything_v2, midas, zoedepth
DEPTH_MODEL=depth_anything_v2

# --- Depth Anything V2 model size ---
# Options: Small (fast), Base (balanced), Large (best quality, slow)
DEPTH_ANYTHING_MODEL_SIZE=Large

# --- Background removal model ---
# Options: u2net, u2netp (faster), isnet-general-use (best quality)
REMBG_MODEL=isnet-general-use

# --- Mesh generation settings ---
# Poisson reconstruction depth (higher = more detail, slower)
# Range: 6 (coarse/fast) → 8 (balanced) → 9 (default) → 10 (fine) → 12 (very fine, slow + heavy RAM)
# Values above 12 are impractical. Below 6 produces blocky, unusable geometry.
MESH_POISSON_DEPTH=9

# Z-scale: controls how "deep" the engraving will appear in crystal
# Range: 0.1 (very flat) → 0.3 (start here) → 0.7 (noticeable depth) → 1.5 (dramatic) → 2.0 (max)
# Values above 2.0 risk clipping the crystal blank. Below 0.1 is nearly invisible.
MESH_Z_SCALE=0.3

# --- Output file format (Stage 05) ---
# Options: obj, stl, ply, all
# OBJ = geometry + UV + normals (editable in Blender/Meshmixer)
# STL = geometry only (smaller, for simple shapes/logos)
# PLY = point cloud format (for MeshLab/CloudCompare review)
# Use "all" to export OBJ + STL + PLY simultaneously.
MESH_EXPORT_FORMAT=all

# --- Export smoothing (Stage 05) ---
# Laplacian smooth iterations applied before export (0 = off)
# Range: 0 (off) → 1–3 (light cleanup) → 5 (moderate) → 10 (heavy, max recommended)
# Values above 10 cause visible mesh shrinkage and surface distortion — not useful.
EXPORT_SMOOTH_ITERS=2

# --- Crystal size scaling (Stage 06) ---
#
# CRYSTAL_PRESET selects a named blank size from the preset table.
# Available presets (W x H x D in mm):
#
#   xs_cube    35 x  35 x  25   keychain / pendant
#   s_cube     60 x  60 x  40   small desk (common starter)
#   m_cube     80 x  80 x  50   medium desk (most popular cube size)
#   l_cube    100 x 100 x  60   large desk, portrait quality
#   xl_cube   120 x 120 x  80   extra large, premium gift
#   s_rect     80 x  60 x  40   small landscape rectangle
#   m_rect    100 x  60 x  40   medium landscape rectangle — MOST POPULAR  <---- DEFAULT
#   l_rect    120 x  80 x  60   large landscape rectangle
#   s_heart    80 x  80 x  40   heart shape (bounding box)
#
# Override with --crystal-size W H D on the CLI for custom blanks.
CRYSTAL_PRESET=m_rect

# Warning threshold in mm. After scaling, if any axis of the mesh is within
# this distance from the crystal edge, a warning is printed so you can rerun
# with a larger preset or trim the mesh. The margin does NOT affect the scale
# factor — the mesh always scales to fit the full crystal blank proportionally.
CRYSTAL_MARGIN_MM=5.0