# ============================================================
# K9 Crystal Pipeline — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to git. .env.example is safe to commit.
# ============================================================

# --- Input / Output paths ---
# Where the pipeline reads source images from
INPUT_DIR=./input

# Where all pipeline outputs are saved (depth maps, meshes, exports)
OUTPUT_DIR=./output

# --- Upscaling settings ---
# Upscale factor before depth estimation (2 or 4 recommended)
UPSCALE_FACTOR=4

# --- Hardware ---
# Set to cpu if no GPU available (will be very slow)
DEVICE=cuda

# ------------------------------------------------------------

# --- Depth estimation model ---
# Options: zoedepth, depth_anything_v2, midas
DEPTH_MODEL=zoedepth

# --- Depth Anything V2 model size ---
# Options: Small (fast), Base (balanced), Large (best quality, slow)
DEPTH_ANYTHING_MODEL_SIZE=Large # Ignored when using zoedepth
# ------------------------------------------------------------

# --- Background removal model ---
# Options: u2net, u2netp (faster), isnet-general-use (best quality)
REMBG_MODEL=isnet-general-use

# ------------------------------------------------------------
# ============================================================

# --- Mesh generation settings ---
# Poisson reconstruction depth (higher = more detail, slower)
MESH_POISSON_DEPTH=9

# Z-scale: controls how "deep" the engraving will appear in crystal
# Lower = flatter, Higher = more dramatic depth. Start with 0.3
MESH_Z_SCALE=0.3

# --- Output file format ---
# Options: obj, stl, ply, all
# Use "all" to export OBJ + STL + PLY simultaneously.
# OBJ = geometry + UV + normals (editable in Blender/Meshmixer)
# STL = geometry only (smaller, for simple shapes/logos)
# PLY = point cloud format (for MeshLab/CloudCompare review)
MESH_EXPORT_FORMAT=all


