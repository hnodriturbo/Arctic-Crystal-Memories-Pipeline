# ─────────────────────────────────────────────────────────────────────────────
# web-converter — environment template
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. This is the only env file that is committed;
# every other .env* is ignored.
#
# How Next.js picks a file (you never set NODE_ENV yourself — Next sets it):
#
#   next dev              NODE_ENV=development  → .env.development, then .env.local
#   next build/next start NODE_ENV=production   → .env.production,  then .env.local
#
# .env.local is loaded last in both, so it WINS over the others. Keep secrets
# and machine-specific absolute paths there; keep tunables that differ between
# dev and prod in .env.development / .env.production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Pipeline 3: converter (Python point-cloud tooling) ───────────────────────
# Absolute path to the pipeline-converter checkout. Defaults to ../pipeline-converter.
CONVERTER_ROOT=D:\path\to\ACM-Pipeline\converter\pipeline-converter
# Optional. Defaults to CONVERTER_ROOT\.venv\Scripts\python.exe (bin/python on POSIX).
CONVERTER_PYTHON=

# ── Pipeline 2: Meshy (photo → 3D model) ─────────────────────────────────────
# Job workspace: input/ photos, work/ cleaned intermediates, output/<job>/ models.
# Defaults to ../meshy-pipeline.
MESHY_ROOT=D:\path\to\ACM-Pipeline\converter\meshy-pipeline
# Optional. Defaults to MESHY_ROOT\.venv\Scripts\python.exe (bin/python on POSIX).
MESHY_PYTHON=

# From https://www.meshy.ai/settings/api — starts with msy_
MESHY_API_KEY=
# Override only to point at a proxy or a future API version.
MESHY_API_URL=https://api.meshy.ai/openapi

# ── Pipeline 1: image clean-up (CPU baseline, optional GPU locally) ──────────
# Absolute path to the K9 image pipeline holding remove_bg.py / upscale.py /
# enhance.py. Leave empty to disable the clean-up step; Meshy's own
# image_enhancement still runs server-side.
IMAGE_PIPELINE_ROOT=D:\path\to\ACM-Pipeline\converter\image-pipeline
# Optional. Defaults to IMAGE_PIPELINE_ROOT\.venv\Scripts\python.exe.
IMAGE_PIPELINE_PYTHON=
# Optional shared rembg model cache. Defaults to ~/.u2net.
U2NET_HOME=

# ── OpenAI (optional, writes Meshy prompts from a photo) ─────────────────────
# Leave empty to hide the "describe this photo" button; everything else works.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna

# ── Public deployment (pipeline.acm.is) ──────────────────────────────────────

# Secret from Meshy's portal, Webhooks section. Used to verify deliveries to
# https://pipeline.acm.is/webhooks/meshy
MESHY_WEBHOOK_SECRET=

# ── Pipeline database ────────────────────────────────────────────────────────
# Local: reuse the machine's postgres superuser. VPS: a dedicated
# acm_pipeline_user role, created during deployment.
DATABASE_URL=postgresql://postgres:password@localhost:5432/acm_pipeline

# ── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# ── R2: acm-pipeline-eu ──────────────────────────────────────────────────────
# Private bucket, EU jurisdiction. Finished jobs are mirrored to jobs/<id>/ so
# they outlive the server; downloads go out as short-lived presigned URLs.
# Token "ACM-Web-Pipeline" - needs Object Read AND Write.
R2_PIPELINE_ACCOUNT_ID=4174c03e715754d2c44a4cdeae409a8d
R2_PIPELINE_ENDPOINT=https://4174c03e715754d2c44a4cdeae409a8d.eu.r2.cloudflarestorage.com
R2_PIPELINE_BUCKET_NAME=acm-pipeline-eu
R2_PIPELINE_ACCESS_KEY_ID=
R2_PIPELINE_SECRET_ACCESS_KEY=
